# Copy to /opt/monolith/.env.production ON monolith-server. Never commit the populated file.
DOMAIN=monolith.example.com
ACME_EMAIL=REPLACE_WITH_YOUR_EMAIL
RELEASE=gce-80
DATABASE_URL='REPLACE_WITH_NEON_APPLICATION_URL_WITH_SSLMODE_REQUIRE'
DATABASE_URL_DIRECT='REPLACE_WITH_NEON_DIRECT_URL_WITH_SSLMODE_REQUIRE'
SECRET_KEY=REPLACE_WITH_INDEPENDENT_RANDOM_SECRET
JWT_SHARED_SECRET=REPLACE_WITH_INDEPENDENT_RANDOM_SECRET
JWT_REFRESH_SECRET=REPLACE_WITH_INDEPENDENT_RANDOM_SECRET
MONOLITH_EMAIL_PROVIDER=smtp
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=REPLACE_WITH_SENDER_EMAIL
EMAIL_HOST_PASSWORD='REPLACE_WITH_APP_PASSWORD'
DEFAULT_FROM_EMAIL='Monolith <REPLACE_WITH_SENDER_EMAIL>'
GCP_PROJECT_ID=REPLACE_WITH_GOOGLE_CLOUD_PROJECT_ID
BACKUP_GCS_BUCKET=REPLACE_WITH_PRIVATE_BUCKET_NAME
