# Copy into .env.docker on a new machine and replace both placeholders.
SECRET_KEY=REPLACE_WITH_A_RANDOM_DJANGO_SECRET
JWT_REFRESH_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS

# Optional Gmail API OAuth2. Configure locally; never commit real values.
# GMAIL_CLIENT_ID=
# GMAIL_CLIENT_SECRET=
# GMAIL_REFRESH_TOKEN=
# GMAIL_SENDER_EMAIL=
# Existing SMTP credentials may be reused instead of creating OAuth credentials.
# MONOLITH_EMAIL_PROVIDER=auto
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_USE_SSL=False
# EMAIL_TIMEOUT=30
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# Legacy aliases MONOLITH_EMAIL / MONOLITH_PASSWORD are also supported.
# Optional read-only backup source (Neon direct connection, no pooler).
# DATABASE_URL_DIRECT=
